    {
      "key": "DeviceMetadataOff",
      "label": "Block Device Metadata Downloads",
      "tip": "Stops Windows fetching device metadata/companion apps from the network - this is why Dell Peripheral Manager, Logitech Options and similar reinstall themselves the first time a dock/peripheral is plugged in.",
      "scope": "HKLM",
      "explorerRestart": false,
      "entries": [
        {"path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Device Metadata", "name": "PreventDeviceMetadataFromNetwork", "type": "DWord", "onValue": "1", "offValue": "<RemoveEntry>"}
      ]
    },
    {
      "key": "WpbtOff",
      "label": "Disable Windows Platform Binary Table Execution",
      "tip": "WPBT lets OEM firmware inject an executable at every boot (how some anti-theft/recovery tools like Absolute/Computrace work). Off by default - leave off for clients actively using Absolute/Computrace, since this would break it.",
      "scope": "HKLM",
      "explorerRestart": false,
      "entries": [
        {"path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Session Manager", "name": "DisableWpbtExecution", "type": "DWord", "onValue": "1", "offValue": "<RemoveEntry>"}
      ]
    },
    {
      "key": "DeliveryOptimizationLanOnly",
      "label": "Delivery Optimization: LAN Only",
      "tip": "Restricts Windows Update peer-to-peer downloads to the local network only (DODownloadMode=1), instead of the default which can pull from or serve to other PCs over the internet.",
      "scope": "HKLM",
      "explorerRestart": false,
      "entries": [
        {"path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\DeliveryOptimization", "name": "DODownloadMode", "type": "DWord", "onValue": "1", "offValue": "<RemoveEntry>"}
      ]
    },
    {
      "key": "TaskbarEndTask",
      "label": "Taskbar Right-Click End Task",
      "tip": "Adds an \"End Task\" option to the right-click menu on taskbar icons - a quick way to force-close a hung app without opening Task Manager.",
      "scope": "HKCU",
      "explorerRestart": true,
      "entries": [
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced\\TaskbarDeveloperSettings", "name": "TaskbarEndTask", "type": "DWord", "onValue": "1", "offValue": "0"}
