    {
      "key": "ClassicContextMenu",
      "label": "Restore Classic Right-Click Context Menu",
      "tip": "Brings back the full Windows 10-style right-click menu instead of Windows 11's shortened one with a 'Show more options' submenu. Creates an empty CLSID override key - a well-documented, fully reversible Windows 11 mechanism (verified live: New-Item + Set-Item with an empty value creates it, Remove-Item -Recurse cleanly removes it). Current-profile only - does not mirror to the Default profile, since this lives under HKCU\\Software\\Classes (backed by UsrClass.dat), not the NTUSER.DAT hive the Default-profile mirror loads.",
      "scope": "HKCU",
      "explorerRestart": true,
      "entries": []
    },
    {
      "key": "PrinterAutoManageOff",
      "label": "Stop Windows From Auto-Changing the Default Printer",
      "tip": "Disables 'Let Windows manage my default printer', which otherwise silently switches the default printer to whichever one was most recently used - a common help-desk complaint in offices with more than one printer. Opt-in and reversible.",
      "scope": "HKCU",
      "entries": [
        {"path": "HKCU:\\Software\\Microsoft\\Windows NT\\CurrentVersion\\Windows", "name": "LegacyDefaultPrinterMode", "type": "DWord", "onValue": "1", "offValue": "<RemoveEntry>"}
      ]
    },
    {
      "key": "FirstLogonAnimationOff",
      "label": "Disable First Sign-In Animation",
      "tip": "Skips the 'Hi' / spinning-dots animation the first time a new account signs in - a small speedup during provisioning when several accounts get set up back to back. Machine-wide (HKLM) GPO-backed value. Opt-in and reversible.",
      "scope": "HKLM",
      "entries": [
        {"path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System", "name": "EnableFirstLogonAnimation", "type": "DWord", "onValue": "0", "offValue": "<RemoveEntry>"}
      ]
    },
    {
      "key": "AutoRestartSignOnOff",
      "label": "Disable Automatic Sign-In After Restart",
      "tip": "Turns off Winlogon's Automatic Restart Sign-On (ARSO), which otherwise re-signs the last interactive user back in (and unlocks their lock-screen apps) after a Windows Update restart with no PIN/password prompt. Recommended for shared/multi-user PCs. Machine-wide (HKLM) GPO-backed value. Opt-in and reversible.",
      "scope": "HKLM",
      "entries": [
        {"path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System", "name": "DisableAutomaticRestartSignOn", "type": "DWord", "onValue": "1", "offValue": "<RemoveEntry>"}
      ]
    },
    {
      "key": "PrintScreenOpensSnipping",
      "label": "Print Screen Key Opens Snipping Tool",
      "tip": "Pins the Print Screen key to open Snipping Tool's screen capture instead of just copying the full screen to the clipboard. This is Windows 11's own default when the value is absent, so 'off' explicitly sets 0 rather than removing the value - simply removing it would fall back to the same enabled behavior as 'on', not actually restore the classic clipboard-copy behavior. Requires an Explorer restart (both explorer.exe and Taskbar.dll read this at startup, per Microsoft's own documented behavior). Opt-in and reversible.",
