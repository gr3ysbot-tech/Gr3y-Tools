{
  "tweaks": [
    {
      "key": "BSoDVerbose",
      "label": "BSoD Verbose Mode",
      "tip": "Gives more information when you blue screen.",
      "scope": "HKLM",
      "explorerRestart": false,
      "entries": [
        {"path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\CrashControl", "name": "DisplayParameters", "type": "DWord", "onValue": "1", "offValue": "0"},
        {"path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\CrashControl", "name": "DisableEmoticon", "type": "DWord", "onValue": "1", "offValue": "0"}
      ]
    },
    {
      "key": "BatteryPercentage",
      "label": "System Tray Battery Percentage",
      "tip": "Shows numeric battery percentage next to the battery icon in the system tray.",
      "scope": "HKCU",
      "explorerRestart": false,
      "entries": [
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "IsBatteryPercentageEnabled", "type": "DWord", "onValue": "1", "offValue": "<RemoveEntry>"}
      ]
    },
    {
      "key": "DarkTheme",
      "label": "Dark Theme for Windows",
      "tip": "Dark Mode for the system and applications.",
      "scope": "HKCU",
      "explorerRestart": true,
      "entries": [
        {"path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize", "name": "AppsUseLightTheme", "type": "DWord", "onValue": "0", "offValue": "1"},
        {"path": "HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize", "name": "SystemUsesLightTheme", "type": "DWord", "onValue": "0", "offValue": "1"}
      ]
    },
    {
      "key": "LongPaths",
      "label": "Enable Long Paths",
      "tip": "Allows file paths longer than 260 characters in Explorer.",
      "scope": "HKLM",
      "explorerRestart": false,
      "entries": [
        {"path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\FileSystem", "name": "LongPathsEnabled", "type": "DWord", "onValue": "1", "offValue": "0"}
      ]
    },
    {
      "key": "ShowFileExt",
      "label": "File Explorer File Extensions",
      "tip": "Shows file extensions in Explorer (.exe, .png, etc.)",
      "scope": "HKCU",
      "explorerRestart": true,
      "entries": [
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "HideFileExt", "type": "DWord", "onValue": "0", "offValue": "1"}
      ]
    },
    {
      "key": "ShowHiddenFiles",
      "label": "File Explorer Hidden Files",
      "tip": "Reveals hidden files in Explorer.",
      "scope": "HKCU",
      "explorerRestart": true,
      "entries": [
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "Hidden", "type": "DWord", "onValue": "1", "offValue": "0"}
      ]
    },
    {
      "key": "GameMode",
      "label": "Game Mode",
      "tip": "Prioritizes gaming performance by allocating system resources to games.",
      "scope": "HKCU",
      "explorerRestart": false,
      "entries": [
        {"path": "HKCU:\\Software\\Microsoft\\GameBar", "name": "AllowAutoGameMode", "type": "DWord", "onValue": "1", "offValue": "0"},
        {"path": "HKCU:\\Software\\Microsoft\\GameBar", "name": "AutoGameModeEnabled", "type": "DWord", "onValue": "1", "offValue": "0"}
      ]
    },
    {
      "key": "DisableLockScreen",
      "label": "Lock Screen - Disable",
      "tip": "Skips the lock screen entirely, goes directly to sign-in on boot and wake.",
      "scope": "HKLM",
      "explorerRestart": false,
      "entries": [
        {"path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Personalization", "name": "NoLockScreen", "type": "DWord", "onValue": "1", "offValue": "<RemoveEntry>"}
      ]
    },
    {
      "key": "LogonAcrylicBlur",
      "label": "Logon Screen Acrylic Blur",
      "tip": "Enables the acrylic blur effect on the login screen background.",
      "scope": "HKLM",
      "explorerRestart": false,
      "entries": [
        {"path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\System", "name": "DisableAcrylicBackgroundOnLogon", "type": "DWord", "onValue": "0", "offValue": "1"}
      ]
    },
    {
      "key": "LogonVerbose",
      "label": "Logon Verbose Mode",
      "tip": "Shows detailed messages during startup/shutdown.",
      "scope": "HKLM",
      "explorerRestart": false,
      "entries": [
        {"path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System", "name": "VerboseStatus", "type": "DWord", "onValue": "1", "offValue": "0"}
      ]
    },
    {
      "key": "NewOutlook",
      "label": "Microsoft Outlook New Version",
      "tip": "Forces the new Outlook application to be used.",
      "scope": "HKCU",
      "explorerRestart": false,
      "entries": [
        {"path": "HKCU:\\SOFTWARE\\Microsoft\\Office\\16.0\\Outlook\\Preferences", "name": "UseNewOutlook", "type": "DWord", "onValue": "1", "offValue": "0"},
        {"path": "HKCU:\\Software\\Microsoft\\Office\\16.0\\Outlook\\Options\\General", "name": "HideNewOutlookToggle", "type": "DWord", "onValue": "0", "offValue": "1"},
        {"path": "HKCU:\\Software\\Policies\\Microsoft\\Office\\16.0\\Outlook\\Options\\General", "name": "DoNewOutlookAutoMigration", "type": "DWord", "onValue": "0", "offValue": "0"},
        {"path": "HKCU:\\Software\\Policies\\Microsoft\\Office\\16.0\\Outlook\\Preferences", "name": "NewOutlookMigrationUserSetting", "type": "DWord", "onValue": "0", "offValue": "<RemoveEntry>"}
      ]
    },
    {
      "key": "MouseAcceleration",
      "label": "Mouse Acceleration",
      "tip": "Cursor movement is affected by the speed of physical mouse movements.",
      "scope": "HKCU",
      "explorerRestart": false,
      "entries": [
        {"path": "HKCU:\\Control Panel\\Mouse", "name": "MouseSpeed", "type": "DWord", "onValue": "1", "offValue": "0"},
        {"path": "HKCU:\\Control Panel\\Mouse", "name": "MouseThreshold1", "type": "DWord", "onValue": "6", "offValue": "0"},
        {"path": "HKCU:\\Control Panel\\Mouse", "name": "MouseThreshold2", "type": "DWord", "onValue": "10", "offValue": "0"}
      ]
    },
    {
      "key": "NumLockOnStartup",
      "label": "Num Lock on Startup",
      "tip": "Turns Num Lock on when the computer starts.",
      "scope": "HKCU",
      "explorerRestart": false,
      "needsHKU": true,
      "entries": [
        {"path": "HKU:\\.Default\\Control Panel\\Keyboard", "name": "InitialKeyboardIndicators", "type": "String", "onValue": "2", "offValue": "0"},
        {"path": "HKCU:\\Control Panel\\Keyboard", "name": "InitialKeyboardIndicators", "type": "String", "onValue": "2", "offValue": "0"}
      ]
    },
    {
      "key": "S0SleepNetwork",
      "label": "S0 Sleep Network Connectivity",
      "tip": "Keeps network connectivity during S0 (modern standby) low-power idle.",
      "scope": "HKCU",
      "explorerRestart": false,
      "entries": [
        {"path": "HKCU:\\SOFTWARE\\Policies\\Microsoft\\Power\\PowerSettings\\f15576e8-98b7-4186-b944-eafa664402d9", "name": "ACSettingIndex", "type": "DWord", "onValue": "1", "offValue": "0"}
      ]
    },
    {
      "key": "S3Sleep",
      "label": "S3 Sleep",
      "tip": "Switches from Modern Standby to S3 Sleep (cuts power to the CPU, keeps RAM refreshed). Only takes effect on hardware whose firmware exposes S3 - see the S3-support check note.",
      "scope": "HKLM",
      "explorerRestart": false,
      "entries": [
        {"path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Power", "name": "PlatformAoAcOverride", "type": "DWord", "onValue": "0", "offValue": "<RemoveEntry>"}
      ]
    },
    {
      "key": "ScrollbarsAlwaysVisible",
      "label": "Scrollbars Always Visible",
      "tip": "Scrollbars are always visible instead of auto-hiding.",
      "scope": "HKCU",
      "explorerRestart": false,
      "entries": [
        {"path": "HKCU:\\Control Panel\\Accessibility", "name": "DynamicScrollbars", "type": "DWord", "onValue": "0", "offValue": "1"}
      ]
    },
    {
      "key": "SettingsHomePage",
      "label": "Settings Home Page",
      "tip": "Shows the Home page in the Windows Settings app.",
      "scope": "HKCU",
      "explorerRestart": false,
      "entries": [
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer", "name": "SettingsPageVisibility", "type": "String", "onValue": "show:home", "offValue": "hide:home"}
      ]
    },
    {
      "key": "StartMenuBingSearch",
      "label": "Start Menu Bing Search",
      "tip": "Enables Bing web search results in Windows Search.",
      "scope": "HKCU",
      "explorerRestart": false,
      "entries": [
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Search", "name": "BingSearchEnabled", "type": "DWord", "onValue": "1", "offValue": "0"}
      ]
    },
    {
      "key": "StartMenuRecommendations",
      "label": "Start Menu Recommendations",
      "tip": "Enables the Recommended section in the Start Menu. WARNING: also affects Windows Spotlight on the Lock Screen.",
      "scope": "HKLM",
      "explorerRestart": true,
      "entries": [
        {"path": "HKLM:\\SOFTWARE\\Microsoft\\PolicyManager\\current\\device\\Start", "name": "HideRecommendedSection", "type": "DWord", "onValue": "0", "offValue": "1"},
        {"path": "HKLM:\\SOFTWARE\\Microsoft\\PolicyManager\\current\\device\\Education", "name": "IsEducationEnvironment", "type": "DWord", "onValue": "0", "offValue": "1"},
        {"path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Explorer", "name": "HideRecommendedSection", "type": "DWord", "onValue": "0", "offValue": "1"}
      ]
    },
    {
      "key": "StickyKeys",
      "label": "Sticky Keys",
      "tip": "Enables Sticky Keys (activates by pressing Shift 5 times).",
      "scope": "HKCU",
      "explorerRestart": false,
      "entries": [
        {"path": "HKCU:\\Control Panel\\Accessibility\\StickyKeys", "name": "Flags", "type": "DWord", "onValue": "506", "offValue": "58"}
      ]
    },
    {
      "key": "TaskbarCenteredIcons",
      "label": "Taskbar Centered Icons",
      "tip": "Centers Taskbar icons instead of left-aligning them.",
      "scope": "HKCU",
      "explorerRestart": true,
      "entries": [
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "TaskbarAl", "type": "DWord", "onValue": "1", "offValue": "0"}
      ]
    },
    {
      "key": "TaskbarSearchIcon",
      "label": "Taskbar Search Icon",
      "tip": "Shows the Search button on the Taskbar.",
      "scope": "HKCU",
      "explorerRestart": false,
      "entries": [
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Search", "name": "SearchboxTaskbarMode", "type": "DWord", "onValue": "1", "offValue": "0"}
      ]
    },
    {
      "key": "TaskbarTaskViewIcon",
      "label": "Taskbar Task View Icon",
      "tip": "Shows the Task View button on the Taskbar.",
      "scope": "HKCU",
      "explorerRestart": false,
      "entries": [
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "ShowTaskViewButton", "type": "DWord", "onValue": "1", "offValue": "0"}
      ]
    },
    {
      "key": "WindowSnapping",
      "label": "Window Snapping",
      "tip": "Enables the window snapping feature when dragging windows.",
      "scope": "HKCU",
      "explorerRestart": false,
      "entries": [
        {"path": "HKCU:\\Control Panel\\Desktop", "name": "WindowArrangementActive", "type": "String", "onValue": "1", "offValue": "0"}
      ]
    },
    {
      "key": "ConsumerFeaturesOff",
      "label": "Disable Consumer Features & Suggestions",
      "tip": "Turns off Start Menu/lock screen ads, app suggestions and consumer account prompts. The DisableWindowsConsumerFeatures policy only applies on Enterprise/Education editions - the rest works on any edition. Verified against Win11Debloat's Disable_Windows_Suggestions.reg before use.",
      "scope": "HKCU",
      "explorerRestart": true,
      "entries": [
        {"path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\CloudContent", "name": "DisableWindowsConsumerFeatures", "type": "DWord", "onValue": "1", "offValue": "<RemoveEntry>"},
        {"path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\CloudContent", "name": "DisableConsumerAccountStateContent", "type": "DWord", "onValue": "1", "offValue": "<RemoveEntry>"},
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SilentInstalledAppsEnabled", "type": "DWord", "onValue": "0", "offValue": "1"},
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SystemPaneSuggestionsEnabled", "type": "DWord", "onValue": "0", "offValue": "1"},
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SoftLandingEnabled", "type": "DWord", "onValue": "0", "offValue": "1"},
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-310093Enabled", "type": "DWord", "onValue": "0", "offValue": "1"},
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-338388Enabled", "type": "DWord", "onValue": "0", "offValue": "1"},
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-338389Enabled", "type": "DWord", "onValue": "0", "offValue": "1"},
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-338393Enabled", "type": "DWord", "onValue": "0", "offValue": "1"},
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-353694Enabled", "type": "DWord", "onValue": "0", "offValue": "1"},
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-353696Enabled", "type": "DWord", "onValue": "0", "offValue": "1"},
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager", "name": "SubscribedContent-353698Enabled", "type": "DWord", "onValue": "0", "offValue": "1"},
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "Start_IrisRecommendations", "type": "DWord", "onValue": "0", "offValue": "1"},
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "ShowSyncProviderNotifications", "type": "DWord", "onValue": "0", "offValue": "1"},
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced", "name": "Start_AccountNotifications", "type": "DWord", "onValue": "0", "offValue": "1"},
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\UserProfileEngagement", "name": "ScoobeSysemSettingEnabled", "type": "DWord", "onValue": "0", "offValue": "1"},
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\SystemSettings\\AccountNotifications", "name": "EnableAccountNotifications", "type": "DWord", "onValue": "0", "offValue": "1"},
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Notifications\\Settings\\Windows.SystemToast.Suggested", "name": "Enabled", "type": "DWord", "onValue": "0", "offValue": "1"},
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Notifications\\Settings\\Windows.SystemToast.BackupReminder", "name": "Enabled", "type": "DWord", "onValue": "0", "offValue": "1"},
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Mobility", "name": "OptedIn", "type": "DWord", "onValue": "0", "offValue": "1"}
      ]
    },
    {
      "key": "DeviceMetadataOff",
      "label": "Block Device Metadata Downloads",
      "tip": "Stops Windows fetching device metadata/companion apps from the network - this is why Dell Peripheral Manager, Logitech Options and similar reinstall themselves the first time a dock/peripheral is plugged in.",
      "scope": "HKLM",
      "explorerRestart": false,
      "entries": [
        {"path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\Device Metadata", "name": "PreventDeviceMetadataFromNetwork", "type": "DWord", "onValue": "1", "offValue": "<RemoveEntry>"}
      ]
    },
    {
      "key": "WpbtOff",
      "label": "Disable Windows Platform Binary Table Execution",
      "tip": "WPBT lets OEM firmware inject an executable at every boot (how some anti-theft/recovery tools like Absolute/Computrace work). Off by default - leave off for clients actively using Absolute/Computrace, since this would break it.",
      "scope": "HKLM",
      "explorerRestart": false,
      "entries": [
        {"path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Session Manager", "name": "DisableWpbtExecution", "type": "DWord", "onValue": "1", "offValue": "<RemoveEntry>"}
      ]
    },
    {
      "key": "DeliveryOptimizationLanOnly",
      "label": "Delivery Optimization: LAN Only",
      "tip": "Restricts Windows Update peer-to-peer downloads to the local network only (DODownloadMode=1), instead of the default which can pull from or serve to other PCs over the internet.",
      "scope": "HKLM",
      "explorerRestart": false,
      "entries": [
        {"path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\DeliveryOptimization", "name": "DODownloadMode", "type": "DWord", "onValue": "1", "offValue": "<RemoveEntry>"}
      ]
    },
    {
      "key": "TaskbarEndTask",
      "label": "Taskbar Right-Click End Task",
      "tip": "Adds an \"End Task\" option to the right-click menu on taskbar icons - a quick way to force-close a hung app without opening Task Manager.",
      "scope": "HKCU",
      "explorerRestart": true,
      "entries": [
        {"path": "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced\\TaskbarDeveloperSettings", "name": "TaskbarEndTask", "type": "DWord", "onValue": "1", "offValue": "0"}
      ]
    },
    {
      "key": "StartMenuClassicLayout",
      "label": "Start Menu: Previous Layout",
      "tip": "Reverts to the Start Menu layout used before Windows 11's newer redesign. Uses an internal, undocumented Windows feature-flag override (not an officially supported setting) - a future Windows update could change or stop honoring this.",
      "scope": "HKLM",
      "explorerRestart": true,
      "entries": [
        {"path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\FeatureManagement\\Overrides\\8\\3036241548", "name": "EnabledState", "type": "DWord", "onValue": "1", "offValue": "<RemoveEntry>"}
      ]
    },
    {
      "key": "BusinessWindowsUpdatePreset",
      "label": "Business Windows Update Policy",
      "tip": "Defers feature updates 365 days and quality updates 4 days, excludes drivers from quality updates (so Dell Command Update / Lenovo System Update own driver delivery instead), and prevents auto-reboot while a user is signed in. Turning this off removes exactly these values, restoring Windows' own update defaults.",
      "scope": "HKLM",
      "explorerRestart": false,
      "entries": [
        {"path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate", "name": "ExcludeWUDriversInQualityUpdate", "type": "DWord", "onValue": "1", "offValue": "<RemoveEntry>"},
        {"path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate", "name": "DeferFeatureUpdates", "type": "DWord", "onValue": "1", "offValue": "<RemoveEntry>"},
        {"path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate", "name": "DeferFeatureUpdatesPeriodInDays", "type": "DWord", "onValue": "365", "offValue": "<RemoveEntry>"},
        {"path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate", "name": "DeferQualityUpdates", "type": "DWord", "onValue": "1", "offValue": "<RemoveEntry>"},
        {"path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate", "name": "DeferQualityUpdatesPeriodInDays", "type": "DWord", "onValue": "4", "offValue": "<RemoveEntry>"},
        {"path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\DriverSearching", "name": "DontSearchWindowsUpdate", "type": "DWord", "onValue": "1", "offValue": "<RemoveEntry>"},
        {"path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU", "name": "AUOptions", "type": "DWord", "onValue": "3", "offValue": "<RemoveEntry>"},
        {"path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU", "name": "NoAutoRebootWithLoggedOnUsers", "type": "DWord", "onValue": "1", "offValue": "<RemoveEntry>"}
      ]
    }
  ]
}
