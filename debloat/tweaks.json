        {"path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate", "name": "DeferQualityUpdates", "type": "DWord", "onValue": "1", "offValue": "<RemoveEntry>"},
        {"path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate", "name": "DeferQualityUpdatesPeriodInDays", "type": "DWord", "onValue": "4", "offValue": "<RemoveEntry>"},
        {"path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\DriverSearching", "name": "DontSearchWindowsUpdate", "type": "DWord", "onValue": "1", "offValue": "<RemoveEntry>"},
        {"path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU", "name": "AUOptions", "type": "DWord", "onValue": "3", "offValue": "<RemoveEntry>"},
        {"path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate\\AU", "name": "NoAutoRebootWithLoggedOnUsers", "type": "DWord", "onValue": "1", "offValue": "<RemoveEntry>"}
      ]
