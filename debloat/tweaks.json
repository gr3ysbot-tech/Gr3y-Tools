        {"path": "HKCU:\\Software\\Policies\\Microsoft\\office\\16.0\\common\\feedback", "name": "Enabled", "type": "DWord", "onValue": "0", "offValue": "<RemoveEntry>"},
        {"path": "HKCU:\\Software\\Policies\\Microsoft\\office\\16.0\\common\\feedback", "name": "SurveyEnabled", "type": "DWord", "onValue": "0", "offValue": "<RemoveEntry>"},
        {"path": "HKCU:\\Software\\Policies\\Microsoft\\office\\16.0\\common\\ptwatson", "name": "PTWOptIn", "type": "DWord", "onValue": "0", "offValue": "<RemoveEntry>"},
        {"path": "HKCU:\\Software\\Policies\\Microsoft\\office\\16.0\\common\\general", "name": "OptInDisable", "type": "DWord", "onValue": "1", "offValue": "<RemoveEntry>"},
